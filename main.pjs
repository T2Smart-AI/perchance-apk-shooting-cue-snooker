// ============================================================
//  SHOOTING BALL  -  a faithful 3D pool/billiards recreation
//  Tunables live in this file. Game logic lives in src/*.js
// ============================================================

$meta
  title = Shooting Ball
  description = A relaxing 3D billiard game with real physics. Sink every ball, collect cues, and clear 1000+ hand-set levels.
  image = ./media/efe37a769e01.jpg
  tags = billiards, pool, 3d, game, physics, cue, ball, relaxing, levels

kv = {import:kv-plugin}

gameInfo
  title = Shooting Ball
  version = 1.0.0
  tagline = A relaxing 3D billiard game with real physics
  levelsPerChapter = 20
  chapters = 50

economy
  startingCoins = 500
  startingGems = 30
  startingHearts = 5
  maxHearts = 5
  heartRefillMinutes = 20
  coinsPerBall = 60
  coinsPerLevel = 150
  gemsPerChapterReward = 5
  starBonus = 100
  firstClearBonus = 50

physics
  gravity = 9.8
  muSlide = 0.28
  muRoll = 0.09
  kDrag = 0.24
  muSpin = 0.8
  muSpinStop = 7.0
  muBall = 0.06
  eBall = 0.95
  eCushion = 0.8
  muCushion = 0.22
  maxSpeed = 13
  hitPower = 1.15 // global shot strength multiplier (+15% on every hit)
  restSpeed = 0.012
  restSpin = 0.35
  simulateSpeed = 1.0
  stepDt = 0.008

// Aiming feel -----------------------------------------------------------------
// dragGain        - how far the aim turns per unit of pointer motion around the
//                   cue ball. 1 = old 1:1 feel; lower = slower/finer aiming.
// maxAngles      - max number of straight "directions" the ball-direction
//                   prediction may trace (3 = the shot direction plus at most
//                   two cushion bounces). Also caps how many recommended
//                   potting angles are calculated.
aiming
  dragGain = 0.45
  maxAngles = 3

table
  halfLength = 1.27
  halfWidth = 0.635
  ballRadius = 0.034
  pocketRadius = 0.068
  sidePocketRadius = 0.062
  cornerMouth = 0.093
  sideMouth = 0.076
  pocketInset = 0.012
  railWidth = 0.115
  cushionDepth = 0.05
  cushionHeight = 0.045
  railHeight = 0.055

// ------------------------------------------------------------------
//  CUES  (rank D < C < B < A < S < SS < SSS)
//  power    - shot power multiplier
//  aimBounces - extra cushion bounces added to the aiming help (Basic/Advanced
//               level is chosen by the player in Settings -> Aiming help)
//  assist   - cue bonus: adds one further rail bounce to the aim prediction
//  spin     - english/spin strength multiplier
//  cost     - price (currency = coins unless gems = true)
//  wood/tip - colours for the 3d model
// ------------------------------------------------------------------
cues
  starter
    name = Maple Starter
    rank = D
    power = 1
    aimBounces = 0
    assist = true
    spin = 0.8
    coinBonus = 1
    cost = 0
    wood = #b98a4f
    wrap = #5b3b22
  ash
    name = Ash Runner
    rank = C
    power = 1.06
    aimBounces = 0
    assist = true
    spin = 0.9
